# Venuees.in — environment variables
#
# Copy this file to `.env.local` for local dev, and paste the same values into
# Vercel (Project → Settings → Environment Variables) for production.
#
# Never commit `.env.local` — it's gitignored.

# ---- Supabase (Auth + Storage) ----
# Find these in: Supabase Dashboard → your project → Settings → API
# - URL:         "Project URL"
# - ANON_KEY:    "Project API keys → anon / public"  (safe to ship to browser)
# - SERVICE_KEY: "Project API keys → service_role"   (server-only, bypasses RLS)
NEXT_PUBLIC_SUPABASE_URL="your-supabase-url"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ---- Database — Drizzle ORM (direct PostgreSQL connection) ----
# Used for all data queries (venues, vendors, enquiries, etc.)
# Find in: Supabase Dashboard → Project Settings → Database → Connection string
# Use the "Transaction pooler" URI (port 6543) for serverless / Next.js.
# Format: postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres"

# ---- Optional ----
# Resend (transactional email) — add when you want enquiry-confirmation emails.
# RESEND_API_KEY=

# Google Places API — powers live review counts on listings with a Place ID,
# and the admin venue-import tool at /dashboard/import.
# Enable "Places API" in Google Cloud Console, then create an API key.
# GOOGLE_PLACES_API_KEY=
